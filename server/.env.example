PORT=8787
MONGODB_URI=mongodb://localhost:27017/medsense

# Comma-separated keys handed to auditors; the extension sends one as X-API-Key.
API_KEYS=change-me

# Gemini via Google AI Studio key...
GEMINI_API_KEY=
# ...or via Vertex AI (keeps data in an India region). Set GOOGLE_GENAI_USE_VERTEXAI=true and fill these instead.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-south1

# Fast model for document checks, stronger model for chat / hard cases.
GEMINI_MODEL=gemini-flash-latest
GEMINI_CHAT_MODEL=gemini-pro-latest
